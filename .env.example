# Copy to .env.local for local development. Never commit .env.local.
#
# Every variable here is optional: the site builds and runs with none of them
# set, which is what a fresh clone gets.

# Google Analytics 4 measurement id.
#
# Leave empty and NOTHING is requested from Google: no script, no cookie, no
# network call. Set it and <GoogleAnalytics> is rendered in the root layout.
#
# NEXT_PUBLIC_ variables are inlined at build time, so this must be set in
# Cloudflare Pages' build environment — setting it after a deploy has no effect
# until the next build.
#
# Find it in GA4: Admin -> Data streams -> your web stream -> Measurement ID.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Canonical origin, used for canonical URLs, the sitemap, robots.txt and
# structured data. No trailing slash.
#
# Defaults to https://unitflip.org, so production needs no value. Set it to
# http://localhost:3000 locally if you want canonical URLs to point at your dev
# server rather than at production.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to "true" on a staging or preview deployment to serve a noindex tag and a
# disallow-all robots.txt, so a second copy of the site is never indexed.
# SITE_NOINDEX=false

# Ad slots reserve layout space but render nothing unless this is "true".
# Turning ads on also means adding the vendor's origins to the
# Content-Security-Policy in public/_headers, or its frames are blocked.
NEXT_PUBLIC_ADS_ENABLED=false
