# Canonical origin: used for canonical URLs, the sitemap, robots.txt and
# structured data. No trailing slash. REQUIRED for `next build` — the build
# fails without it rather than baking in a wrong host. On Vercel it falls back
# to the deployment's own domain when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to "true" on staging environments to serve noindex and a disallow-all
# robots.txt. Vercel preview deployments are noindexed automatically.
SITE_NOINDEX=false

# Analytics is opt-in. Empty disables it entirely: no requests, no scripts.
# Supported values: "" (off) | "debug" (logs events to the console) | "queue"
NEXT_PUBLIC_ANALYTICS_PROVIDER=

# Ad slots render nothing unless this is "true". Adding a provider also
# requires allowing its origins in the Content-Security-Policy (next.config.ts)
# and updating the privacy page.
NEXT_PUBLIC_ADS_ENABLED=false
